# Copie ce fichier en .env pour le développement local. Ne jamais committer .env.
# En production (Cloud Run), ces valeurs sont injectées via Secret Manager / variables
# d'environnement du service — jamais via ce fichier.

NODE_ENV=development
PORT=8080

# Origines autorisées pour CORS, séparées par des virgules (l'app mobile n'en a pas besoin,
# utile pour un futur client web admin en dev local).
CORS_ORIGINS=http://localhost:19006

# --- Base de données (Cloud SQL PostgreSQL) ---
# Local : connexion directe ou via Cloud SQL Auth Proxy sur 127.0.0.1:5432.
# Prod (Cloud Run) : connexion via le Cloud SQL Node.js Connector, pas cette URL TCP directe.
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/dermato?schema=public"

# --- Firebase Authentication ---
# Local uniquement : chemin vers une clé de compte de service Firebase Admin (fichier JSON
# téléchargé depuis Firebase Console > Paramètres du projet > Comptes de service).
# Ce fichier ne doit jamais être commité (déjà exclu par .gitignore : *.serviceaccount.json).
# En prod (Cloud Run), ne pas définir cette variable : le SDK Admin utilise automatiquement
# le compte de service attaché au service Cloud Run (Application Default Credentials).
GOOGLE_APPLICATION_CREDENTIALS=./secrets/firebase-admin.serviceaccount.json
FIREBASE_PROJECT_ID=dermato-XXXXX

# --- Google Sheets (export, optionnel) ---
# Compte de service : suffisant pour Sheets car on ne fait qu'ajouter des lignes à
# un fichier déjà existant (créé par un humain, partagé en Éditeur avec l'email du
# compte de service) — pas de souci de quota de stockage dans ce cas.
# Voir README.md, section "Google Drive / Sheets à faire" pour la procédure complète.
GOOGLE_SERVICE_ACCOUNT_KEY_FILE=./secrets/google-service-account.json
GOOGLE_SHEETS_ID=
GOOGLE_SHEETS_TAB_NAME=Dossiers

# --- Google Drive (photos, requis) ---
# OAuth2 sur un compte Google personnel, PAS un compte de service : depuis 2023,
# Google interdit aux comptes de service de créer des fichiers (aucun quota de
# stockage propre), même dans un dossier partagé en Éditeur. Procédure (une seule
# fois) :
# 1. Google Cloud Console > API et services > Identifiants > Créer des identifiants
#    > ID client OAuth > type "Application de bureau".
# 2. node scripts/authorizeDrive.mjs <CLIENT_ID> <CLIENT_SECRET> — ouvre un lien à
#    visiter une fois dans un navigateur, récupère le refresh token affiché.
# 3. Créer un dossier Drive, copier son id depuis l'URL (/folders/CET_ID).
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REFRESH_TOKEN=
GOOGLE_DRIVE_PHOTOS_FOLDER_ID=
# Dossier Drive séparé (créer un 2e dossier, même compte) pour les conclusions
# médicales rédigées par l'admin — jamais mélangées aux photos/rapports patient.
GOOGLE_DRIVE_RESPONSES_FOLDER_ID=

# --- Rate limiting ---
RATE_LIMIT_WINDOW_MINUTES=15
RATE_LIMIT_MAX_REQUESTS=300

# --- SMS (Africa's Talking) ---
# Optionnel : tant qu'AT_API_KEY et AT_USERNAME ne sont pas renseignés, l'envoi de
# l'accusé de réception par SMS est silencieusement désactivé (voir services/sms.ts)
# — le serveur démarre et fonctionne normalement sans elles.
# Compte : https://account.africastalking.com — AT_USERNAME="sandbox" avec la clé API
# sandbox pour tester gratuitement sans numéro dédié. AT_SENDER_ID optionnel (ID
# d'expéditeur validé) ; laissé vide, Africa's Talking utilise un expéditeur partagé.
AT_API_KEY=
AT_USERNAME=
AT_SENDER_ID=
