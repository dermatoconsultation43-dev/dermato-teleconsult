generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------- Enums ----------

enum ConsultationStatus {
  draft
  pending
  confirmed
  seen
  completed
  cancelled
}

enum Sexe {
  M
  F
}

enum StatutMatrimonial {
  celibataire
  marie
  vie_en_couple
  veuf_veuve
  autre
}

enum DureeUnite {
  jours
  semaines
  mois
  annees
}

enum Demangeaison {
  oui
  non
  parfois
  nuit
}

enum EntourageStatus {
  oui
  non
  ne_sait_pas
}

enum PhotoSlot {
  vue_generale
  vue_rapprochee
  complementaire
}

enum PhotoStatus {
  pending_upload
  uploaded
  failed
  deleted
}

enum ChangedByType {
  patient
  admin
  system
}

enum JourSemaine {
  lundi
  mardi
  mercredi
  jeudi
  vendredi
  samedi
}

enum AdminRole {
  admin
  // Compte partagé par les agents terrain (voir agent.routes.ts) : peut
  // seulement créer/corriger ses propres dossiers walk-in avant soumission,
  // jamais la liste complète, les statistiques, ou changer un statut — voir
  // middleware/rbac.ts#requireFullAdmin, qui exclut ce rôle des routes admin.
  agent
}

// ---------- Comptes ----------

// firebaseUid et email nullable : un dossier créé par un agent sur le terrain (voir
// AdminUser.walkInPatients) n'a pas de compte Firebase propre — la personne ne se
// connecte jamais elle-même. @unique sur un champ nullable autorise déjà plusieurs
// NULL côté Postgres (NULL ≠ NULL) — l'unicité ne s'applique qu'aux valeurs
// renseignées, aucun index partiel manuel requis ici.
model Patient {
  id               String    @id @default(uuid()) @db.Uuid
  firebaseUid      String?   @unique @map("firebase_uid")
  nom              String
  prenom           String
  telephone        String
  email            String?
  createdByAdminId String?   @map("created_by_admin_id") @db.Uuid
  createdByAdmin   AdminUser? @relation(fields: [createdByAdminId], references: [id])
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")
  deletedAt        DateTime? @map("deleted_at")

  consultations Consultation[]
  statusChanges StatusHistory[] @relation("PatientStatusChanges")

  @@map("patients")
}

model AdminUser {
  id          String    @id @default(uuid()) @db.Uuid
  firebaseUid String    @unique @map("firebase_uid")
  nom         String
  prenom      String
  email       String    @unique
  role        AdminRole @default(admin)
  isActive    Boolean   @default(true) @map("is_active")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  appointmentsCreated Appointment[]
  statusChanges       StatusHistory[] @relation("AdminStatusChanges")
  walkInPatients      Patient[]

  @@map("admin_users")
}

// ---------- Dossier ----------

model Consultation {
  id         String             @id @default(uuid()) @db.Uuid
  refNumber  Int                @unique @default(autoincrement()) @map("ref_number")
  clientUuid String             @unique @map("client_uuid") @db.Uuid
  patientId  String             @map("patient_id") @db.Uuid
  patient    Patient            @relation(fields: [patientId], references: [id], onDelete: Restrict)
  status     ConsultationStatus @default(draft)

  // Étape 1 — informations personnelles (intake à la date de la consultation)
  nomComplet          String?             @map("nom_complet")
  sexe                Sexe?
  statutMatrimonial   StatutMatrimonial?  @map("statut_matrimonial")
  age                 Int?
  dateNaissance       DateTime? @map("date_naissance") @db.Date
  ville               String?
  profession          String?
  telephoneContact    String?  @map("telephone_contact")
  emailContact        String?  @map("email_contact")
  confirmationWhatsapp Boolean? @map("confirmation_whatsapp")
  poidsKg             Decimal? @map("poids_kg") @db.Decimal(5, 2)
  tailleCm            Decimal? @map("taille_cm") @db.Decimal(5, 1)
  temperatureC        Decimal? @map("temperature_c") @db.Decimal(3, 1)

  // Étape 2 — motif
  motif                      String?
  conseilCosmetiqueDemande   Boolean @default(false) @map("conseil_cosmetique_demande")
  conseilCosmetiquePrecision String? @map("conseil_cosmetique_precision")

  // Étape 3 — histoire du problème
  dureeValeur                  Int?        @map("duree_valeur")
  dureeUnite                   DureeUnite? @map("duree_unite")
  localisationPremieresLesions String?     @map("localisation_premieres_lesions")

  // Étape 4 — démangeaisons
  demangeaison Demangeaison?

  // Étape 5 — zones du corps touchées (carte du corps cliquable, sélection
  // multiple) — remplace l'usage de localisationPremieresLesions/
  // autresLesionsLocalisation comme saisie principale dans l'app mobile ; les deux
  // champs texte restent en base pour ne pas perdre les brouillons existants et
  // pour un complément libre éventuel.
  lesionZones String[] @default([]) @map("lesion_zones")

  // Étape 6 — autres lésions / zones sensibles
  autresLesions             Boolean? @map("autres_lesions")
  autresLesionsAspect       String?  @map("autres_lesions_aspect")
  autresLesionsLocalisation String?  @map("autres_lesions_localisation")
  zonesSensiblesAtteintes   Boolean? @map("zones_sensibles_atteintes")
  zonesSensiblesPrecision   String?  @map("zones_sensibles_precision")

  // Étape 7 — entourage
  entourageStatus    EntourageStatus? @map("entourage_status")
  entouragePrecision String?          @map("entourage_precision")

  // Étape 8 — produits et traitements utilisés
  produitsUtilises  Boolean? @map("produits_utilises")
  produitsPrecision String?  @map("produits_precision")

  // Étape 9 — antécédents
  antecedentsMedicaux  Boolean? @map("antecedents_medicaux")
  antecedentsPrecision String?  @map("antecedents_precision")
  notesComplementaires String?  @map("notes_complementaires")

  // Étape 10 — photos
  photosQualiteConfirmee Boolean? @map("photos_qualite_confirmee")

  submittedAt DateTime? @map("submitted_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  lesionTypes    ConsultationLesionType[]
  availabilities ConsultationAvailability[]
  photos         Photo[]
  consent        Consent?
  appointment    Appointment?
  statusHistory  StatusHistory[]

  @@index([patientId])
  @@index([status])
  @@index([submittedAt])
  @@map("consultations")
}

// ---------- Aspect des lésions (sélection multiple) ----------

model LesionType {
  code         String  @id
  labelFr      String  @map("label_fr")
  description  String?
  displayOrder Int     @default(0) @map("display_order")

  consultations ConsultationLesionType[]

  @@map("lesion_types")
}

model ConsultationLesionType {
  consultationId String       @map("consultation_id") @db.Uuid
  consultation   Consultation @relation(fields: [consultationId], references: [id], onDelete: Cascade)
  lesionCode     String       @map("lesion_code")
  lesionType     LesionType   @relation(fields: [lesionCode], references: [code])
  precision      String? // utilisé surtout quand lesionCode = "autre"

  @@id([consultationId, lesionCode])
  @@map("consultation_lesion_types")
}

// ---------- Photos ----------

model Photo {
  id             String       @id @default(uuid()) @db.Uuid
  consultationId String       @map("consultation_id") @db.Uuid
  consultation   Consultation @relation(fields: [consultationId], references: [id], onDelete: Cascade)
  slot           PhotoSlot
  driveFileId    String       @unique @map("drive_file_id")
  mimeType       String       @map("mime_type")
  sizeBytes      BigInt?      @map("size_bytes")
  widthPx        Int?         @map("width_px")
  heightPx       Int?         @map("height_px")
  status         PhotoStatus  @default(pending_upload)
  uploadedAt     DateTime?    @map("uploaded_at")
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")
  deletedAt      DateTime?    @map("deleted_at")

  @@index([consultationId])
  @@map("photos")
}

// ---------- Disponibilités ----------

model Availability {
  id           String      @id @default(uuid()) @db.Uuid
  jourSemaine  JourSemaine @map("jour_semaine")
  heureDebut   DateTime    @map("heure_debut") @db.Time(0)
  heureFin     DateTime    @map("heure_fin") @db.Time(0)
  label        String
  actif        Boolean     @default(true)
  displayOrder Int         @default(0) @map("display_order")

  consultations ConsultationAvailability[]
  appointments  Appointment[]

  @@map("availabilities")
}

model ConsultationAvailability {
  id             String        @id @default(uuid()) @db.Uuid
  consultationId String        @map("consultation_id") @db.Uuid
  consultation   Consultation  @relation(fields: [consultationId], references: [id], onDelete: Cascade)
  availabilityId String?       @map("availability_id") @db.Uuid
  availability   Availability? @relation(fields: [availabilityId], references: [id])
  autrePrecision String?       @map("autre_precision") // rempli seulement si "Autres plages"
  createdAt      DateTime      @default(now()) @map("created_at")

  @@index([consultationId])
  @@map("consultation_availabilities")
}

// ---------- Consentement ----------

model Consent {
  id                 String       @id @default(uuid()) @db.Uuid
  consultationId     String       @unique @map("consultation_id") @db.Uuid
  consultation       Consultation @relation(fields: [consultationId], references: [id], onDelete: Cascade)
  consentTextVersion String       @map("consent_text_version")
  consentedAt        DateTime     @map("consented_at")
  ipAddress          String?      @map("ip_address")
  createdAt          DateTime     @default(now()) @map("created_at")

  @@map("consents")
}

// ---------- Rendez-vous confirmé ----------

model Appointment {
  id               String        @id @default(uuid()) @db.Uuid
  consultationId   String        @unique @map("consultation_id") @db.Uuid
  consultation     Consultation  @relation(fields: [consultationId], references: [id], onDelete: Cascade)
  availabilityId   String?       @map("availability_id") @db.Uuid
  availability     Availability? @relation(fields: [availabilityId], references: [id])
  scheduledAt      DateTime?     @map("scheduled_at")
  notes            String?
  createdByAdminId String        @map("created_by_admin_id") @db.Uuid
  createdByAdmin   AdminUser     @relation(fields: [createdByAdminId], references: [id], onDelete: Restrict)
  createdAt        DateTime      @default(now()) @map("created_at")
  updatedAt        DateTime      @updatedAt @map("updated_at")

  @@map("appointments")
}

// ---------- Journal des statuts ----------

model StatusHistory {
  id                 String              @id @default(uuid()) @db.Uuid
  consultationId     String              @map("consultation_id") @db.Uuid
  consultation       Consultation        @relation(fields: [consultationId], references: [id], onDelete: Cascade)
  previousStatus     ConsultationStatus? @map("previous_status")
  newStatus          ConsultationStatus  @map("new_status")
  changedByType      ChangedByType       @map("changed_by_type")
  changedByPatientId String?             @map("changed_by_patient_id") @db.Uuid
  changedByPatient   Patient?            @relation("PatientStatusChanges", fields: [changedByPatientId], references: [id])
  changedByAdminId   String?             @map("changed_by_admin_id") @db.Uuid
  changedByAdmin     AdminUser?          @relation("AdminStatusChanges", fields: [changedByAdminId], references: [id])
  reason             String?
  createdAt          DateTime            @default(now()) @map("created_at")

  @@index([consultationId])
  @@index([createdAt])
  @@map("status_history")
}
