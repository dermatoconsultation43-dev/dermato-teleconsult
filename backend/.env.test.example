# Copie ce fichier en .env.test pour lancer les tests d'intégration (npm test).
# Base dédiée aux tests, distincte de la base de dev (.env) — les tests créent et
# suppriment des lignes librement, jamais sur la base de dev.
#
# Provisionnement local (une fois) :
#   createdb -h 127.0.0.1 -U <role_dev> -O <role_dev> dermato_test
#
# Firebase Auth, Google Drive et Google Sheets sont mockés dans les tests (voir
# test/mocks.ts) — ces valeurs n'ont besoin d'être ni réelles ni valides.

NODE_ENV=test
DATABASE_URL="postgresql://USER:PASSWORD@127.0.0.1:5432/dermato_test?schema=public"
FIREBASE_PROJECT_ID=dermato-test
GOOGLE_SERVICE_ACCOUNT_KEY_FILE=dermato-test-key.json
GOOGLE_OAUTH_CLIENT_ID=dermato-test-client-id
GOOGLE_OAUTH_CLIENT_SECRET=dermato-test-client-secret
GOOGLE_OAUTH_REFRESH_TOKEN=dermato-test-refresh-token
GOOGLE_DRIVE_PHOTOS_FOLDER_ID=dermato-test-folder
GOOGLE_DRIVE_RESPONSES_FOLDER_ID=dermato-test-responses-folder
